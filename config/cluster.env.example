# Copy to config/cluster.env and edit every environment-specific value.
# This file intentionally contains no credentials.

IMAGE=glm53-sm121:local
CONTAINER_NAME=glm53-vllm
SERVED_MODEL_NAME=glm-5.3-flash-nvfp4-sm121

# Set local model/cache paths on each node; REMOTE_ROOT is the worker repo path.
MODEL_HOST=/models/GLM-5.3-Flash-NVFP4
CACHE_HOST=/var/cache/glm53-vllm
REMOTE_ROOT=/opt/glm-5.3-flash-2xdgx-spark-vllm

# SSH alias or hostname reachable from the head node.
WORKER_SSH=dgx-spark-worker

# Replace the documentation-only addresses with your RoCE fabric addresses.
HEAD_IP=192.0.2.10
WORKER_IP=192.0.2.11
FABRIC_IF=enp1s0f0np0
FABRIC_HCA=rocep1s0f0
MASTER_PORT=25053
API_PORT=8000

# Qualified production profile.
MTP_TOKENS=3
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=12
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.82

# Explicit opt-in for a separately measured tuning campaign:
# PROFILE=experimental
# EXECUTION_MODE=eager             # eager or graph
# REASONING_PARSER=glm45
# NCCL_HCA_LIST=rocep1s0f0,roceP2p1s0f0
# NCCL_CHANNELS=8                  # measure before retaining this override
# NCCL_PROTO_VALUE='^LL128'        # measure; not a universal recommendation
# CPUSET_CPUS=5-9,15-19           # verify fast-core IDs on the target machines
# CHAT_TEMPLATE_HOST=/absolute/path/chat-template.jinja  # see docs/tuning.md
# NCCL_CROSS_NIC_VALUE=0
# NCCL_LOG_LEVEL=INFO
# EXTRA_VLLM_ARGS=()
# MTP_TOKENS=0 disables speculation in an experimental profile.
